# ---------------------------------------------------------------------------
# MediTalk backend environment configuration (PLACEHOLDERS ONLY — do not commit
# real keys here). Copy this file to backend/.env and fill in your own values,
# or export the same variables in your shell / hosting platform.
#
#   bash:  set -a && source backend/.env && set +a && ./mvnw spring-boot:run
#   pwsh:  Get-Content backend/.env | ForEach-Object { ... }   # or set them in the IDE
#
# backend/.env is git-ignored. The mobile app never receives these values.
# ---------------------------------------------------------------------------

# --- OCR -------------------------------------------------------------------
# OCR.space key used to read prescription images (server-side only).
OCR_SPACE_API_KEY=
OCR_SPACE_ENABLED=true
OCR_SPACE_LANGUAGE=eng          # eng | auto
OCR_SPACE_ENGINE=2              # 2 = best for printed text
OCR_SPACE_TIMEOUT_SECONDS=45
OCR_SPACE_MAX_PAYLOAD_BYTES=1000000   # free plan upload limit
OCR_SPACE_PAID_PLAN=false

# Optional backup OCR provider (also handles mixed Bangla/English pages).
GOOGLE_VISION_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_API_KEY=

# --- Gemini -----------------------------------------------------------------
# Dedicated credential for structured prescription extraction (OCR -> JSON).
PRESCRIPTION_GEMINI_API_KEY=

# Dedicated credential for the patient-facing health chat assistant.
HEALTH_CHAT_GEMINI_API_KEY=

# Model configuration (shared defaults, override per feature if needed).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-2.5-flash
HEALTH_CHAT_GEMINI_MODEL=
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_SECONDS=45

# Optional: single credential used only when the dedicated keys above are empty.
GEMINI_API_KEY=

# --- Application ------------------------------------------------------------
JWT_SECRET=change-me
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
ADMIN_EMAIL=admin@meditalk.com
ADMIN_PASSWORD=AdminPass123!
