# ---------------------------------------------------------------------------
# MediTalk — .gitignore
# ---------------------------------------------------------------------------
# Build / runtime artifacts
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
.idea/
*.iml
.vscode/
nbproject/private/
build/

# Dependency caches
**/node_modules

# Local secrets (real keys!). Copy to backend/.env and fill in your own values.
**/.env
**/.env.local
*.pem

# Runtime data (patient records, uploads)
backend/data/
backend/uploads/
backend/target/

# Logs & archives (regeneratable, large)
*.log
*.zip
*.mov
*.pdf
backend-run*.log
backend-new.log

# OS / editor junk
.DS_Store
Thumbs.db
